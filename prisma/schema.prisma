// BT-Member Event Management — Database Schema
// Stack: Next.js 14 (pages router), Neon Postgres, NextAuth v4, Tailwind CSS
// Hosted on Vercel. All API routes use raw pg queries via lib/db.js (service-role style,
// no RLS at the DB layer — access control happens in app code).
// Auth: Google OAuth via NextAuth. Session stores user.id, user.role (best role across events).
// Roles: admin > lead > member
//
// NOTE: Prisma is used ONLY for schema management (`npx prisma db push` against Neon).
// No Prisma Client is used at runtime — every query goes through lib/db.js (raw pg).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String   @unique
  event_date DateTime @db.Date
  status     String   @default("active") // "active" | "archived"
  created_at DateTime @default(now()) @db.Timestamptz(6)

  members       EventMember[]
  activities    Activity[]
  announcements Announcement[]
  email_logs    EmailLog[]
  activity_logs ActivityLog[]
  task_types    TaskType[]

  @@map("events")
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?  // null = invited but never signed in (pending)
  email          String   @unique
  avatar_url     String?
  preferred_lang    String    @default("zh")
  last_signed_in_at DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)

  memberships        EventMember[]
  led_activities     Activity[]    @relation("ActivityLead")
  co_led_activities  Activity[]    @relation("ActivityCoLead")
  tasks_as_assignee1 Task[]        @relation("TaskAssignee1")
  tasks_as_assignee2 Task[]        @relation("TaskAssignee2")
  tasks_created      Task[]        @relation("TaskCreatedBy")
  announcements          Announcement[]
  announcements_reported Announcement[] @relation("AnnouncementReporter")
  email_logs             EmailLog[]
  activity_logs          ActivityLog[]
  task_types_created     TaskType[]

  @@map("users")
}

model EventMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id  String   @db.Uuid
  user_id   String   @db.Uuid
  role      String   @default("member") // "admin" | "lead" | "member"
  joined_at DateTime @default(now()) @db.Timestamptz(6)

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@map("event_members")
}

model Activity {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id   String  @db.Uuid
  lead_id    String  @db.Uuid
  co_lead_id String? @db.Uuid
  name       String
  icon       String  @default("ti-star") // Tabler icon class e.g. "ti-star"
  sort_order Int     @default(0)

  event         Event          @relation(fields: [event_id], references: [id], onDelete: Cascade)
  lead          User           @relation("ActivityLead", fields: [lead_id], references: [id])
  co_lead       User?          @relation("ActivityCoLead", fields: [co_lead_id], references: [id])
  tasks         Task[]
  announcements Announcement[]

  @@map("activities")
}

model Task {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activity_id   String    @db.Uuid
  assignee_1_id String    @db.Uuid
  assignee_2_id String?   @db.Uuid
  created_by    String    @db.Uuid
  title         String
  status        String    @default("open") // "open" | "in_progress" | "done"
  due_date      DateTime? @db.Date
  note          String?   // optional note from assignee (last saved note)
  description   String?   // optional task description
  task_type     String    @default("general")
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  activity  Activity @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  assignee1 User     @relation("TaskAssignee1", fields: [assignee_1_id], references: [id])
  assignee2 User?    @relation("TaskAssignee2", fields: [assignee_2_id], references: [id])
  creator   User     @relation("TaskCreatedBy", fields: [created_by], references: [id])

  @@map("tasks")
}

model TaskType {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id   String   @db.Uuid
  name       String
  created_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  event   Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  creator User? @relation(fields: [created_by], references: [id])

  @@map("task_types")
}

model Announcement {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id    String    @db.Uuid
  created_by  String    @db.Uuid
  message     String
  activity_id String?   @db.Uuid
  reporter_id String?   @db.Uuid
  reported_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  event    Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  creator  User      @relation(fields: [created_by], references: [id])
  activity Activity? @relation(fields: [activity_id], references: [id], onDelete: SetNull)
  reporter User?     @relation("AnnouncementReporter", fields: [reporter_id], references: [id], onDelete: SetNull)

  @@map("announcements")
}

// Tracks every outbound email sent by the daily cron job
model EmailLog {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id String   @db.Uuid
  user_id  String   @db.Uuid
  task_id  String?  @db.Uuid
  type     String   // "daily_digest" | "overdue_reminder" | "announcement"
  status   String   @default("sent") // "sent" | "failed"
  sent_at  DateTime @default(now()) @db.Timestamptz(6)

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id])

  @@map("email_log")
}

// Audit log — one row per meaningful change
// entity_type: 'task' | 'activity' | 'announcement'
// action:      'created' | 'updated' | 'deleted' | 'status_changed' | 'note_added'
// field_changed / old_value / new_value populated for status_changed + field-level updates
// note populated for note_added actions
model ActivityLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id      String?  @db.Uuid
  user_id       String?  @db.Uuid
  entity_type   String   // 'task' | 'activity' | 'announcement'
  entity_id     String?  @db.Uuid
  entity_name   String?
  action        String   // 'created' | 'updated' | 'deleted' | 'status_changed' | 'note_added'
  field_changed String?
  old_value     String?
  new_value     String?
  note          String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  event Event? @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [user_id], references: [id])

  @@map("activity_log")
}

// ─────────────────────────────────────────────────────────────────────────
// Inventory Control — Lantern Inventory module (independent of events/members;
// access gated via lib/inventory.js, not event_members). Tables prefixed
// inv_lantern_ to keep them apart from event data. See lib/inventory.js and
// PROGRESS.md "Inventory Control" sections for the access model and roadmap.
// ─────────────────────────────────────────────────────────────────────────

model InventoryCategory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name_zh    String
  name_en    String
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  lanterns InventoryLantern[]

  @@map("inv_lantern_categories")
}

model InventoryLocation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique // A1, B4, Cabin, E3, …
  zone            String   // A | B | C | D | E | Cabin — for grouping
  description     String?
  photo_url       String?  // Vercel Blob URL, full size
  photo_thumb_url String?  // Vercel Blob URL, thumbnail (~400px) — used in the zone-grouped list
  sort_order      Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  created_by      String?  // user email from session — decoupled from the users table on purpose
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_by      String?  // user email from session

  lanterns    InventoryLantern[]
  inspections InventoryInspection[]

  @@map("inv_lantern_locations")
}

// Shared by lanterns, locations and inspections (owner_type / owner_id, no FK —
// kept loose like activity_log so one table serves several owning entities).
model InventoryPhoto {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_type  String   // 'lantern' | 'location' | 'inspection'
  owner_id    String   @db.Uuid
  url         String   // Vercel Blob URL, full size (~1600px long edge)
  thumb_url   String   // Vercel Blob URL, thumbnail (~400px)
  is_primary  Boolean  @default(false)
  taken_at    DateTime @default(now()) @db.Timestamptz(6)
  uploaded_by String?  // user email from session

  @@map("inv_lantern_photos")
}

// One record per lantern GROUP: either a single lantern, or several identical
// lanterns recorded together with qty. Groups are never split into individual units.
model InventoryLantern {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tag_id           String   @unique @default(dbgenerated("('LT-' || lpad(nextval('inv_lantern_tag_seq')::text, 4, '0'))"))
  name_zh          String
  name_en          String?
  category_id      String?  @db.Uuid
  qty              Int      @default(1)
  voltage          String?  // 'AC110V' | 'DC24V'
  power_w          Decimal? @db.Decimal(6, 2)
  height_ft        Decimal? @db.Decimal(5, 2)
  width_ft         Decimal? @db.Decimal(5, 2)
  depth_ft         Decimal? @db.Decimal(5, 2)
  location_id      String?  @db.Uuid
  condition        String   @default("Good") // Good | OK | Fair | Bad — copied from latest inspection
  cloth_damage_pct Int      @default(0)
  frame_damage_pct Int      @default(0)
  displayable      Boolean  @default(true) // false when cloth OR frame damage >= NOT_DISPLAYABLE_DAMAGE_PCT (lib/inventoryConstants.js); computed in app code on every save
  status           String   @default("Active") // Active | Retired | Missing
  display_decision String?  // Stage 4: Candidate | Selected | Needs repair | Not this year
  label_attached   Boolean  @default(false)
  notes            String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  created_by       String?  // user email from session
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_by       String?  // user email from session

  category    InventoryCategory?    @relation(fields: [category_id], references: [id])
  location    InventoryLocation?    @relation(fields: [location_id], references: [id])
  inspections InventoryInspection[]

  @@map("inv_lantern_lanterns")
}

// Condition history — one row each time someone checks a lantern. Saving an
// inspection updates the lantern's current condition/damage%/location too.
model InventoryInspection {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lantern_id       String   @db.Uuid
  inspected_at     DateTime @default(now()) @db.Timestamptz(6)
  inspected_by     String   // user email from session
  condition        String
  cloth_damage_pct Int
  frame_damage_pct Int
  location_id      String?  @db.Uuid
  notes            String?

  lantern  InventoryLantern   @relation(fields: [lantern_id], references: [id], onDelete: Cascade)
  location InventoryLocation? @relation(fields: [location_id], references: [id])

  @@map("inv_lantern_inspections")
}

// Separate from the event-scoped ActivityLog above — who changed what and when
// within the Lantern Inventory module.
model InventoryActivityLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  table_name    String
  record_id     String?  @db.Uuid
  record_name   String?
  action        String
  field_changed String?
  old_value     String?
  new_value     String?
  user_email    String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@map("inv_lantern_activity_log")
}
